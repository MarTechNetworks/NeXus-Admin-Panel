# Backend API base URL the admin console talks to.
#
# - Bare origin, NO trailing slash (endpoint paths already include `/api`).
# - Leave unset to run against built-in MOCK data instead of a real backend.
#
# Production: NEXT_PUBLIC_API_URL=https://api.nexus-web3.com
NEXT_PUBLIC_API_URL=https://api.nexus-web3.com
